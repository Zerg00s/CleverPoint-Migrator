<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window is allocated when the
         app launches (the UI is the Photino WebView). Console output goes nowhere;
         crashes are captured in logs\app.log instead. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CleverPoint.Migrator.Ux</RootNamespace>
    <AssemblyName>CleverPoint.Migrator.Ux</AssemblyName>
    <!-- Embed the app icon into the exe so it stands out in Explorer / taskbar. -->
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <!-- Keep publish output (its own wwwroot/_content) out of subsequent source scans. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;publish/**</DefaultItemExcludes>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- A release passes its number (-p:Version=X.Y.Z, Sign-App.ps1). Without one this is a build from
         source: StampDevVersion below gives it the number of the last release, marked "-dev". -->
    <VersionGiven Condition="'$(Version)' != ''">true</VersionGiven>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The last release is the nearest "vX.Y.Z" tag behind the commit being built. Without git, or
       without tags, the version stays at the SDK's default and nothing fails. -->
  <Target Name="StampDevVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(VersionGiven)' != 'true'">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="LastReleaseTag" />
      <Output TaskParameter="ExitCode" PropertyName="LastReleaseExit" />
    </Exec>
    <PropertyGroup Condition="'$(LastReleaseExit)' == '0' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(LastReleaseTag)', '^v\d+\.\d+\.\d+$'))">
      <Version>$(LastReleaseTag.Substring(1))</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)-dev</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Include="wwwroot/favicon.ico" Link="favicon.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('wwwroot/favicon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.2" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the real migration engine + history store unchanged. -->
    <ProjectReference Include="..\CleverPoint.Migrator.Core\CleverPoint.Migrator.Core.csproj" />
    <!-- Build the Windows WebView2 sign-in helper alongside us (don't reference its
         assembly; it's a different TFM and launched as a separate process). -->
    <ProjectReference Include="..\CleverPoint.Migrator.SignInHelper\CleverPoint.Migrator.SignInHelper.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <!-- Build the command line (cpm) alongside us; BundleCommandLine copies it next to our exe. -->
    <ProjectReference Include="..\CleverPoint.Migrator.Cli\CleverPoint.Migrator.Cli.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="_CpmAssembly" />
  </ItemGroup>

  <!-- A plain build gets cpm next to the app, where the app and the agent skill expect it. It shares
       this folder's Core and package assemblies. A release publishes cpm itself (Sign-App.ps1). -->
  <Target Name="BundleCommandLine" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <_CpmDir>@(_CpmAssembly->'%(RootDir)%(Directory)')</_CpmDir>
    </PropertyGroup>
    <ItemGroup>
      <_CpmFiles Include="$(_CpmDir)cpm*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CpmFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

  <!-- Bundle the sign-in helper's full output (exe + WebView2 native loader) into
       SignInHelper\ next to our exe, where BrowserSignIn looks for it first. -->
  <Target Name="BundleSignInHelper" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_HelperOut>$(MSBuildProjectDirectory)\..\CleverPoint.Migrator.SignInHelper\bin\$(Configuration)\net8.0-windows\</_HelperOut>
    </PropertyGroup>
    <ItemGroup>
      <_HelperFiles Include="$(_HelperOut)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HelperFiles)"
          DestinationFiles="@(_HelperFiles->'$(OutDir)SignInHelper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true"
          Condition="'@(_HelperFiles)' != ''" />
  </Target>

  <!-- Guard against the single-file publish trap: PublishSingleFile self-extracts to a
       temp dir, moving AppContext.BaseDirectory away from wwwroot -> Photino's file
       provider throws DirectoryNotFoundException at startup. Publish as a self-contained
       FOLDER instead (see BUILD.md / photino-fluent-findings.md). -->
  <Target Name="BlockSingleFilePublish" BeforeTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Text="Do not publish CleverPoint.Migrator.Ux with PublishSingleFile=true (Photino serves wwwroot from next to the exe). Publish a self-contained folder: dotnet publish -c Release -r win-x64 --self-contained true -o publish/windows" />
  </Target>

  <!-- Photino serves UI from a physical wwwroot next to the exe. A plain build keeps
       static web assets in a manifest and does NOT copy them; this target does, so
       `dotnet run` works the same as publish. (See photino-fluent-findings.md.) -->
  <Target Name="CopyStaticWebAssetsToOutputDir" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <_AppWwwroot Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppWwwroot)"
          DestinationFiles="@(_AppWwwroot->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(StaticWebAsset)"
          DestinationFiles="@(StaticWebAsset->'$(OutDir)wwwroot\%(BasePath)\%(RelativePath)')"
          Condition="'%(StaticWebAsset.SourceType)' == 'Package'"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css"
          DestinationFiles="$(OutDir)wwwroot\$(AssemblyName).styles.css"
          Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css')"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
