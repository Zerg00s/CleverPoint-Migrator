@page "/connections"
@namespace CleverPoint.Migrator.Ux.Components.Pages
@inject UxSettings Settings
@inject BrowserSignIn SignIn
@inject IToastService Toasts

<div class="page-head">
    <h1>Connections</h1>
</div>

<div class="btn-row" style="margin-bottom:14px;">
    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())" @onclick="OpenAdd">Add connection</FluentButton>
</div>

@if (Settings.Connections.Count == 0)
{
    <FluentCard><p class="hint">No connections yet. Add a SharePoint site to get started.</p></FluentCard>
}
else
{
    <div class="conn-table cp-grid">
        <FluentDataGrid Items="@Settings.Connections.AsQueryable()" ResizableColumns="true"
                        GridTemplateColumns="minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 2.4fr) minmax(0, 1.6fr) 240px" ShowHover="true" Style="width:100%;">
            <PropertyColumn Property="@(c => c.Name)" Title="Name" />
            <TemplateColumn Title="Sign-in">@SignInLabel(context)</TemplateColumn>
            <TemplateColumn Title="Site"><span class="conn-site" title="@context.SiteUrl">@context.SiteUrl</span></TemplateColumn>
            <TemplateColumn Title="Status">
                <span class="conn-status"><span class="conn-dot @StatusClass(context)"></span> <span>@StatusText(context)</span></span>
            </TemplateColumn>
            <TemplateColumn Title="">
                <div class="conn-actions">
                    @if (_busy == context.SiteUrl)
                    {
                        <FluentProgressRing Style="width:20px;height:20px;" />
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent" @onclick="@(() => Connect(context, false))"
                                      IconStart="@(IsConnected(context) ? (Icon)new Icons.Regular.Size20.ArrowClockwise() : new Icons.Regular.Size20.PlugConnected())">
                            @(IsConnected(context) ? "Reconnect" : "Connect")
                        </FluentButton>
                        @if (UxConnectionResolver.IsDelegated(context))
                        {
                            <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.ArrowDownload())"
                                          Title="Export this connection for another computer (contains no secret)" @onclick="@(() => Export(context))" />
                            @if (UxConnectionResolver.IsSignedIn(context))
                            {
                                <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.SignOut())"
                                              Title="Sign out on this computer" @onclick="@(() => SignOut(context))" />
                            }
                        }
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.Delete())"
                                      Title="Remove" @onclick="@(() => Remove(context))" />
                    }
                </div>
            </TemplateColumn>
        </FluentDataGrid>
    </div>
}

<AddConnectionDialog @ref="_addDialog" OnAdded="OnConnectionAdded" />

@code {
    private AddConnectionDialog? _addDialog;
    private string? _busy;

    // Set when arriving from the home screen's "Add your first connection" button
    // (/connections?add=1) so the Add dialog opens automatically.
    [Parameter, SupplyParameterFromQuery(Name = "add")]
    public string? Add { get; set; }

    protected override void OnInitialized() => Settings.EnsureLoaded();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(Add))
        {
            await OpenAdd();
            // OnAfterRenderAsync does not auto-rerender; force a paint so the
            // dialog's flipped Hidden state actually shows.
            StateHasChanged();
        }
    }

    private async Task OpenAdd() { if (_addDialog is not null) await _addDialog.OpenAsync(); }

    // New connections authenticate immediately so you see status right away.
    private async Task OnConnectionAdded(SavedConnection c)
    {
        StateHasChanged();
        await Connect(c, false);
    }

    private async Task Connect(SavedConnection c, bool _)
    {
        _busy = c.SiteUrl;
        StateHasChanged();
        try
        {
            if (c.AuthMode == "AppCertificate")
            {
                UxConnectionResolver.Invalidate(c);
                var (ok, msg) = await UxConnectionResolver.TestAsync(c);
                Toasts.ShowToast(ok ? ToastIntent.Success : ToastIntent.Error, msg);
            }
            else if (UxConnectionResolver.IsDelegated(c))
            {
                // Renews silently when it can; the system browser opens only when it has to.
                UxConnectionResolver.Invalidate(c);
                try
                {
                    await UxConnectionResolver.EnsureDelegatedAsync(c, c.SiteUrl);
                    var (ok, msg) = await UxConnectionResolver.TestAsync(c);
                    Toasts.ShowToast(ok ? ToastIntent.Success : ToastIntent.Error, ok ? $"{msg} Signed in as {c.AccountUpn}." : msg);
                }
                catch (Exception ex)
                {
                    c.LastStatus = "Failed: " + ex.Message;
                    c.LastVerifiedUtc = DateTime.UtcNow;
                    Toasts.ShowToast(ToastIntent.Warning, ex.Message);
                }
            }
            else
            {
                var fresh = SignIn.HasSession(c.SiteUrl);
                var (ok, msg) = await SignIn.SignInAsync(c.SiteUrl, fresh);
                c.LastStatus = ok ? "Connected (browser)" : msg;
                c.LastVerifiedUtc = DateTime.UtcNow;
                Toasts.ShowToast(ok ? ToastIntent.Success : ToastIntent.Warning, ok ? "Signed in." : msg);
            }
            Settings.Save();
        }
        finally { _busy = null; StateHasChanged(); }
    }

    private void Remove(SavedConnection c)
    {
        Settings.Connections.Remove(c);
        Settings.Save();
        Toasts.ShowInfo($"Removed '{c.Name}'.");
    }

    private async Task SignOut(SavedConnection c)
    {
        var who = c.AccountUpn;
        await UxConnectionResolver.SignOutAsync(c);
        Settings.Save();
        Toasts.ShowInfo($"Signed out {who} on this computer.");
    }

    /// <summary>
    /// Writes what another computer needs to use the same tenant app: site, tenant ID and app ID.
    /// A Microsoft sign-in app has no secret, so this file is safe to send.
    /// </summary>
    private void Export(SavedConnection c)
    {
        try
        {
            var path = LogExporter.DownloadsPath($"CleverPoint connection - {new Uri(c.SiteUrl).Host}", "json");
            File.WriteAllText(path, ConnectionFile.Serialize(c));
            Toasts.ShowSuccess($"Saved {path}. Import it on the other computer under Add connection.");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Could not export: {ex.Message}");
        }
    }

    private static string SignInLabel(SavedConnection c) =>
        UxConnectionResolver.IsCert(c) ? "App + certificate"
        : UxConnectionResolver.IsDelegated(c) ? "Microsoft sign-in"
        : "Browser";

    private bool IsConnected(SavedConnection c) =>
        UxConnectionResolver.IsCert(c) ? c.LastStatus.StartsWith("Connected", StringComparison.OrdinalIgnoreCase)
        : UxConnectionResolver.IsDelegated(c)
            ? UxConnectionResolver.IsSignedIn(c) && c.LastStatus.StartsWith("Connected", StringComparison.OrdinalIgnoreCase)
        : SignIn.HasSession(c.SiteUrl);

    private string StatusText(SavedConnection c)
    {
        if (IsConnected(c))
            return UxConnectionResolver.IsCert(c) ? c.LastStatus
                : UxConnectionResolver.IsDelegated(c) ? $"Connected as {c.AccountUpn}"
                : "Connected";
        if (!string.IsNullOrEmpty(c.LastStatus) && c.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase)) return c.LastStatus;
        return "Not connected";
    }

    private string StatusClass(SavedConnection c) =>
        IsConnected(c) ? "ok"
        : c.LastStatus.StartsWith("Failed", StringComparison.OrdinalIgnoreCase) ? "fail" : "idle";
}
