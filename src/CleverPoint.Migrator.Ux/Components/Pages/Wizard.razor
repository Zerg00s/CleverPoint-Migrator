@page "/wizard"
@namespace CleverPoint.Migrator.Ux.Components.Pages
@inject NavigationManager Nav
@inject IToastService Toasts
@inject UxMigrationService Migrations
@inject ActivityService Activity
@inject UxSettings Settings
@inject PendingMigration Pending
@inject HistoryService History
@inject MigrationRunner Runner
@inject BrowserSignIn SignIn

<div class="page-head wizard-head">
    <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                  Disabled="_running" @onclick="BackToExplorer">Back to explorer</FluentButton>
    <h1>New Copy Task</h1>
</div>

<FluentCard>
    @if (!_batch)
    {
        <div class="field" style="max-width:520px; margin-bottom:18px;">
            <span class="field-label">Task name</span>
            <FluentTextField @bind-Value="_taskName" Style="width:100%;" Disabled="_running" />
        </div>
    }

    <div class="copy-setup">
        <div class="cs-side cs-source">
            <div class="cs-head">Source</div>
            <div class="ro-field">
                <span class="field-label">Site</span>
                <div class="ro-value">@_src</div>
            </div>
            <div class="ro-field">
                <span class="field-label">@(_batch ? "Lists & libraries" : "List / library")</span>
                @if (_batch)
                {
                    <ul class="batch-list">
                        @foreach (var j in _jobs)
                        {
                            <li>@j.SourceListTitle @(j.WholeList ? "" : $"({(j.IsLibrary ? j.SelectedPaths.Count : j.SelectedItemIds.Count)} selected)")</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="ro-value">@_list</div>
                    @if (_jobs.Count == 1 && !_jobs[0].WholeList)
                    {
                        <span class="hint">Copying @(_jobs[0].IsLibrary ? _jobs[0].SelectedPaths.Count : _jobs[0].SelectedItemIds.Count) selected
                            @(_jobs[0].IsLibrary ? "files/folders" : "items") only. Folders bring their contents.</span>
                    }
                }
            </div>
        </div>

        <div class="cs-arrow"><FluentIcon Value="@(new Icons.Regular.Size32.ArrowRight())" /></div>

        <div class="cs-side cs-target">
            <div class="cs-head">Target</div>
            <div class="ro-field">
                <span class="field-label">Site</span>
                <div class="ro-value">@_tgt</div>
            </div>
            @if (_batch)
            {
                <span class="hint">Each list is created on the target under its own name@(_sameSite ? " with “ - Copy” appended" : "").</span>
            }
            else if (_targetLocked)
            {
                <div class="ro-field">
                    <span class="field-label">Target list</span>
                    <div class="ro-value">@_targetTitle</div>
                </div>
                @if (!string.IsNullOrEmpty(_targetSubfolder))
                {
                    <div class="ro-field">
                        <span class="field-label">Target folder</span>
                        <div class="ro-value">@_targetSubfolder</div>
                    </div>
                }
                <span class="hint">Items are added to this existing @(string.IsNullOrEmpty(_targetSubfolder) ? "list" : "folder"), so the name and URL are fixed.</span>
            }
            else
            {
                <div class="field" style="margin-bottom:10px;">
                    <span class="field-label">Target list title</span>
                    <FluentTextField @bind-Value="_targetTitle" @bind-Value:after="CheckTargetAsync" Immediate="true" ImmediateDelay="400"
                                     Style="width:100%;" Disabled="_running" />
                </div>
                <div class="field">
                    <span class="field-label">Target list URL (the part after the site)</span>
                    <FluentTextField @bind-Value="_targetUrl" @bind-Value:after="StateHasChanged" Immediate="true"
                                     Style="width:100%;" Disabled="_running" Placeholder="e.g. Lists/MyList or MyLibrary" />
                    <span class="url-preview">@FullTargetUrl()</span>
                </div>
            }
            @if (!_batch && !_targetLocked && _targetState != TargetState.Unknown)
            {
                <span class="target-chip @TargetChipClass">@_targetStateMsg</span>
            }
        </div>
    </div>

    <div class="section-title" style="margin-top:22px;">Options</div>
    <div class="grid cols-2" style="gap:14px 28px; margin-bottom:6px;">
        <div class="field">
            <span class="field-label">Copy mode</span>
            @if (_lockContentOnly)
            {
                <FluentSelect TOption="string" @bind-Value="_copyMode" Style="width:100%;" Disabled="_running">
                    <FluentOption Value="content">Content only (add the picked items to the target list)</FluentOption>
                    <FluentOption Value="permissions">Permissions only (nothing is copied)</FluentOption>
                </FluentSelect>
                @if (!PermsOnly)
                {
                    <span class="hint">You picked specific items, so they're added to the target list (no structure to recreate).</span>
                }
            }
            else
            {
                <FluentSelect TOption="string" @bind-Value="_copyMode" Style="width:100%;" Disabled="_running">
                    <FluentOption Value="full">Structure + content (recreate the list, then copy items)</FluentOption>
                    <FluentOption Value="content">Content only (target list already exists)</FluentOption>
                    <FluentOption Value="structure">Structure only (recreate the list and columns, no items)</FluentOption>
                    <FluentOption Value="permissions">Permissions only (nothing is copied)</FluentOption>
                </FluentSelect>
            }
        </div>
        @if (PermsOnly)
        {
            <div class="field">
                <span class="field-label">What this does</span>
                <span class="hint" style="opacity:.85; line-height:1.5;">
                    No list, library, folder, file or item is created, copied or changed. Everything on the source that has its
                    own permissions gets the same permissions on the target, replacing what the target item has now. Files and
                    folders are matched by path. List items are matched through the copy this tool made earlier. Anything with
                    no match on the target is reported and skipped.
                </span>
            </div>
            <div class="field" style="grid-column: 1 / -1;">
                <FluentCheckbox @bind-Value="_resetInherit" Disabled="_running"
                                Label="Also restore inheritance on target items where the source item inherits" />
                <span class="hint">Leave this off to keep permissions that were set by hand on the target and have no counterpart on the source.</span>
            </div>
        }
        <div class="field" hidden="@PermsOnly">
            <span class="field-label">Engine</span>
            <FluentSelect TOption="string" @bind-Value="_engine" Style="width:100%;" Disabled="_running || !string.IsNullOrEmpty(_targetSubfolder)">
                <FluentOption Value="Classic">Classic copy (recommended for most migrations)</FluentOption>
                <FluentOption Value="MigrationApi">Migration API (best for very large libraries)</FluentOption>
            </FluentSelect>
            @if (!string.IsNullOrEmpty(_targetSubfolder))
            {
                <span class="hint">Copying into a target folder uses the Classic engine (the Migration API ignores subfolders).</span>
            }
        </div>
        @if (ApiEngineNotices.Count > 0)
        {
            <div class="field" style="grid-column: 1 / -1;">
                <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                    <strong>This copy will use the Classic engine instead of the Migration API engine, because:</strong>
                    <ul style="margin:6px 0 0 18px; padding:0;">
                        @foreach (var notice in ApiEngineNotices)
                        {
                            <li>@notice</li>
                        }
                    </ul>
                </FluentMessageBar>
            </div>
        }
        <div class="field" hidden="@PermsOnly">
            <span class="field-label">File versions to copy</span>
            <FluentNumberField @bind-Value="_maxVersions" Min="1" Max="2000" Style="width:140px;" Disabled="_running" />
            <span class="hint">1 = latest only. Set 2000 to copy the full version history (SharePoint keeps up to 500 by default).</span>
        </div>
        <div class="field" hidden="@PermsOnly">
            <span class="field-label">If the item already exists on the target</span>
            <FluentSelect TOption="string" @bind-Value="_existingMode" Style="width:100%;" Disabled="_running">
                <FluentOption Value="Overwrite">Overwrite (replace the target copy)</FluentOption>
                <FluentOption Value="CopyIfNewer">Copy if newer (skip when the target is up to date)</FluentOption>
                <FluentOption Value="Skip">Skip (leave existing target items alone)</FluentOption>
            </FluentSelect>
        </div>
    </div>

    <div hidden="@PermsOnly">
    <div class="section-title" style="margin-top:18px;">Date filter (optional)</div>
    <FluentCheckbox @bind-Value="_useDateFilter" Label="Only copy items within a date range" Disabled="_running" />
    </div>
    @if (_useDateFilter && !PermsOnly)
    {
        <div class="grid cols-2" style="gap:14px 28px; margin-top:10px; max-width:760px;">
            <div class="field">
                <span class="field-label">Based on</span>
                <FluentSelect TOption="string" @bind-Value="_dateField" Style="width:100%;" Disabled="_running">
                    <FluentOption Value="Modified">Last modified date</FluentOption>
                    <FluentOption Value="Created">Created date</FluentOption>
                </FluentSelect>
            </div>
            <div></div>
            <div class="field">
                <span class="field-label">From (on or after)</span>
                <FluentDatePicker @bind-Value="_dateFrom" Culture="DateDisplayCulture" Disabled="_running" Style="width:100%;" />
            </div>
            <div class="field">
                <span class="field-label">To (on or before)</span>
                <FluentDatePicker @bind-Value="_dateTo" Culture="DateDisplayCulture" Disabled="_running" Style="width:100%;" />
            </div>
            <div></div>
            <span class="hint">Dates are in your local timezone. The whole day is included for both ends of the range.</span>
        </div>
    }

    <div class="grid cols-2" style="gap:8px 28px; margin:10px 0 4px;" hidden="@PermsOnly">
        <FluentCheckbox @bind-Value="_preserve" Label="Preserve authors and dates" Disabled="_running" />
        @if (_showAttachments)
        {
            <FluentCheckbox @bind-Value="_attachments" Label="Copy attachments" Disabled="_running" />
        }
        <FluentCheckbox @bind-Value="_permissions" Label="Copy unique permissions" Disabled="_running" />
        <FluentCheckbox @bind-Value="_contentTypes" Label="Copy content types &amp; site columns" Disabled="_running" />
    </div>

    @if (BeginBlockedReason is { } reason)
    {
        <div style="margin-top:16px;">
            <FluentMessageBar Intent="MessageIntent.Warning">@reason</FluentMessageBar>
        </div>
    }
    <div class="begin-bar">
        <FluentButton Appearance="Appearance.Accent" Class="cp-cta" IconStart="@(new Icons.Regular.Size24.Play())"
                      Disabled="@(BeginBlockedReason is not null)" @onclick="Start">@(PermsOnly ? "Apply permissions" : "Begin copy")</FluentButton>
    </div>

    @if (_status is not null)
    {
        <div style="margin-top:14px;">
            <FluentMessageBar Intent="@_statusIntent">@_status</FluentMessageBar>
        </div>
    }
</FluentCard>

@code {
    [SupplyParameterFromQuery(Name = "src")] public string? Src { get; set; }
    [SupplyParameterFromQuery(Name = "tgt")] public string? Tgt { get; set; }
    [SupplyParameterFromQuery(Name = "lists")] public string? Lists { get; set; }
    [SupplyParameterFromQuery(Name = "tlist")] public string? TargetListName { get; set; }

    private string _src = "", _tgt = "", _list = "", _taskName = "", _targetTitle = "", _targetUrl = "", _engine = "Classic";
    private string _targetSubfolder = "";   // subfolder inside the target list (drop target), read-only
    private string _copyMode = "full";
    private bool _lockContentOnly;
    private bool _targetLocked;
    private int _maxVersions = 1;
    private string _existingMode = "Overwrite";
    private bool _useDateFilter;
    private string _dateField = "Modified";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private List<PendingJob> _jobs = new();
    private bool _batch, _sameSite;
    private bool _preserve = true, _attachments = true, _permissions, _contentTypes = true;
    // Permissions-only mode: apply the source's permissions to content that is already on the target.
    private bool PermsOnly => _copyMode == "permissions";

    // Why the Migration API engine cannot do this copy as configured. The run then uses the Classic
    // engine by itself; this tells the user before they start, and the run log repeats it.
    private List<string> ApiEngineNotices
    {
        get
        {
            if (_engine != "MigrationApi") return new();
            var reasons = Core.MigrationApi.MigrationApiEngine.ReasonsToUseClassic(new CopyOptions
            {
                ExistingMode = _existingMode switch { "CopyIfNewer" => ExistingItemMode.CopyIfNewer, "Skip" => ExistingItemMode.Skip, _ => ExistingItemMode.Overwrite },
                MaxVersions = _maxVersions,
                PreserveAuthorsAndDates = _preserve,
                CopyPermissions = _permissions,
                PermissionsOnly = PermsOnly,
                TargetSubfolderRelative = _targetSubfolder,
            }, sourceIsLibrary: true);
            // Lists in the selection are a reason of their own; libraries next to them still use the API.
            if (_jobs.Any(j => !j.IsLibrary))
                reasons.Add(_jobs.All(j => !j.IsLibrary) ? "it only copies libraries, and this is a list" : "it only copies libraries (the lists in this selection use the Classic engine)");
            return reasons;
        }
    }
    private bool _resetInherit;

    // Attachments only apply to list items; libraries don't have them.
    private bool _showAttachments => !(_jobs.Count == 1 && _jobs[0].IsLibrary);

    private enum TargetState { Unknown, New, Exists, Mismatch }
    private TargetState _targetState = TargetState.Unknown;
    private string _targetStateMsg = "";
    private string TargetChipClass => _targetState switch
    {
        TargetState.New => "st-ok",
        TargetState.Exists => "st-running",
        TargetState.Mismatch => "st-issues",
        _ => "",
    };

    // Block Begin only for genuinely-broken combos; everything else is allowed.
    private string? BeginBlockedReason =>
        _targetState == TargetState.Mismatch ? _targetStateMsg
        : (_copyMode == "content" && _targetState == TargetState.New)
            ? "Content-only needs an existing target list, but this one doesn't exist yet. Switch to Structure + content, or point at an existing list."
        : (PermsOnly && _targetState == TargetState.New)
            ? "Permissions only needs an existing target list, but this one doesn't exist yet. Copy the list first, or point at an existing list."
        : null;
    private const bool _running = false;   // execution moved to the background runner
    private string? _status;
    private MessageIntent _statusIntent = MessageIntent.Info;

    private void BackToExplorer()
    {
        // Returning to the explorer should land back on the same source/target, so ask
        // for a restore (?restore=1). A plain Copy nav has no param and starts fresh.
        Nav.NavigateTo("/explore?restore=1");
    }

    protected override void OnInitialized()
    {
        // "Run again" navigates here with query params for a SPECIFIC run, so those win.
        // The explorer flow navigates without params and carries its richer selection
        // through PendingMigration. Preferring Pending when params are present would
        // show the last explorer selection for every run, which is the bug we fix here.
        if (string.IsNullOrWhiteSpace(Src) && Pending.Jobs.Count > 0)
        {
            _src = Pending.SourceSite;
            _tgt = Pending.TargetSite;
            _jobs = Pending.Jobs.Select(j => new PendingJob
            {
                SourceListTitle = j.SourceListTitle, SourceListPath = j.SourceListPath, IsLibrary = j.IsLibrary,
                SourceFolder = j.SourceFolder,
                SelectedPaths = j.SelectedPaths.ToList(), SelectedItemIds = j.SelectedItemIds.ToList(),
                SelectedFolderCount = j.SelectedFolderCount, SelectedFileCount = j.SelectedFileCount,
            }).ToList();
        }
        else
        {
            _src = Src ?? "";
            _tgt = Tgt ?? "";
            _jobs = (Lists ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(t => new PendingJob { SourceListTitle = t }).ToList();
            // Query-param navigation (e.g. "Run again") carries no list type, so the
            // source list/library kind is resolved live before the target check runs.
            _resolveSourceTypes = true;
        }
        var fromRunAgain = !string.IsNullOrWhiteSpace(Src);
        _batch = _jobs.Count > 1;
        // Picking specific files/folders/items means there's no structure to recreate;
        // lock to content-only so "Structure + content" isn't offered. The Pending flags
        // belong to the explorer flow only, never to a query-param "Run again".
        _lockContentOnly = (!fromRunAgain && Pending.ContentOnly) || _jobs.Any(j => !j.WholeList);
        if (_lockContentOnly) _copyMode = "content";
        _list = _jobs.FirstOrDefault()?.SourceListTitle ?? "";
        _sameSite = string.Equals(_src.TrimEnd('/'), _tgt.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
        // "Run again" restores the exact target list from the run. The explorer flow may
        // instead drop a selection into an already-open target list (content-only).
        if (fromRunAgain && !string.IsNullOrWhiteSpace(TargetListName))
        {
            _targetTitle = TargetListName!;
            _targetUrl = DefaultUrl(_targetTitle);
        }
        else if (!fromRunAgain && !string.IsNullOrWhiteSpace(Pending.TargetListTitle))
        {
            _targetTitle = Pending.TargetListTitle!;
            _targetUrl = string.IsNullOrWhiteSpace(Pending.TargetListUrl) ? DefaultUrl(_targetTitle) : Pending.TargetListUrl!;
            _targetSubfolder = Pending.TargetSubfolderRelative ?? "";
            _targetPath = Pending.TargetListPath;
            _targetLocked = true;
        }
        else
        {
            _targetTitle = _sameSite && _list.Length > 0 ? $"{_list} - Copy" : _list;
            _targetUrl = DefaultUrl(_targetTitle);
        }
        // Name the task by what it copies. A specific selection reads
        // "Copy 2 folders and 3 files from LMAS to cleverpointlab".
        var sel = _jobs.Count == 1 && !_jobs[0].WholeList ? _jobs[0] : null;
        if (sel is not null)
        {
            var parts = new List<string>();
            if (sel.SelectedFolderCount > 0) parts.Add($"{sel.SelectedFolderCount} folder{(sel.SelectedFolderCount == 1 ? "" : "s")}");
            if (sel.SelectedFileCount > 0) parts.Add($"{sel.SelectedFileCount} {(sel.IsLibrary ? "file" : "item")}{(sel.SelectedFileCount == 1 ? "" : "s")}");
            var sub = parts.Count > 0 ? string.Join(" and ", parts) : "selected items";
            _taskName = $"Copy {sub} from {SiteName(_src)} to {SiteName(_tgt)}";
        }
        else
        {
            var next = (History.GetRuns(1).FirstOrDefault()?.Id ?? 0) + 1;
            var what = _batch ? $"{_jobs.Count} lists" : (_list.Length > 0 ? _list : "copy");
            _taskName = $"Copy task {next}: {what}";
        }
        Settings.EnsureLoaded();
        _engine = Settings.DefaultEngine == "MigrationApi" ? "MigrationApi" : "Classic";
        // The Migration API engine ignores a target subfolder, so a folder-targeted copy must
        // use the Classic engine (which honors it); otherwise files would land in the list root.
        if (!string.IsNullOrEmpty(_targetSubfolder)) _engine = "Classic";
        _maxVersions = Math.Clamp(Settings.DefaultMaxVersions, 1, 2000);
        if (!fromRunAgain && Pending.RestoredSettings is { } restored) ApplyRestoredSettings(restored);
    }

    // "Run again" / "Copy task": start from the settings the original run used, not the app
    // defaults. Only fields the scope recorded are applied (older runs leave the defaults).
    private void ApplyRestoredSettings(RunScope r)
    {
        if (r.Engine is "Classic" or "MigrationApi" && string.IsNullOrEmpty(_targetSubfolder)) _engine = r.Engine;
        if (r.CopyMode is "full" or "content" or "structure" && !_lockContentOnly) _copyMode = r.CopyMode;
        if (r.CopyMode == "permissions") _copyMode = "permissions";
        if (r.ResetTargetWhereSourceInherits is { } reset) _resetInherit = reset;
        if (r.MaxVersions is { } mv) _maxVersions = Math.Clamp(mv, 1, 2000);
        if (r.ExistingMode is "Overwrite" or "CopyIfNewer" or "Skip") _existingMode = r.ExistingMode;
        if (r.DateField is "Modified" or "Created") _dateField = r.DateField;
        if (r.ModifiedSinceUtc.HasValue || r.ModifiedBeforeUtc.HasValue)
        {
            // Reverse of LocalDayStartUtc: the stored bounds are local-midnight UTC instants;
            // "before" is the midnight AFTER the picked "to" day. Shift by half a day before
            // taking .Date so a DST change (midnight landing at 23:00 or 01:00) can't move the
            // restored day by one.
            _useDateFilter = true;
            _dateFrom = r.ModifiedSinceUtc?.ToLocalTime().AddHours(12).Date;
            _dateTo = r.ModifiedBeforeUtc?.ToLocalTime().AddHours(-12).Date;
        }
        if (r.PreserveAuthorsAndDates is { } p) _preserve = p;
        if (r.CopyAttachments is { } a) _attachments = a;
        if (r.CopyPermissions is { } perm) _permissions = perm;
    }

    private static string DefaultUrl(string title) => string.Concat(title.Where(char.IsLetterOrDigit));

    // Show dates with the month spelled out (e.g. "14 May 2026") to avoid d/m vs m/d confusion.
    private static readonly System.Globalization.CultureInfo DateDisplayCulture = BuildDateCulture();
    private static System.Globalization.CultureInfo BuildDateCulture()
    {
        var c = (System.Globalization.CultureInfo)System.Globalization.CultureInfo.InvariantCulture.Clone();
        c.DateTimeFormat.ShortDatePattern = "dd MMM yyyy";
        return c;
    }

    // Treat the picked day's local midnight as the UTC boundary (whole-day range).
    private static DateTime LocalDayStartUtc(DateTime date)
        => DateTime.SpecifyKind(date.Date, DateTimeKind.Local).ToUniversalTime();

    private bool _resolveSourceTypes;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ResolveSourceTypesAsync();
            await CheckTargetAsync();
        }
    }

    // When the source list kind is unknown (navigated here by query params), ask the
    // source site whether each list is a library so the mismatch check is accurate.
    private async Task ResolveSourceTypesAsync()
    {
        if (!_resolveSourceTypes || string.IsNullOrWhiteSpace(_src)) return;
        var conn = UxConnectionResolver.Find(Settings, _src);
        if (conn is null || !UxConnectionResolver.CanResolve(conn, SignIn)) return;
        try
        {
            var resolved = UxConnectionResolver.Resolve(conn, _src, SignIn);
            // Titles are compared here, not with $filter=Title eq: the filter matches the site's own
            // language while the title we hold may be in the user's (translated built-in lists).
            using var doc = await resolved.Rest.GetJsonAsync(
                $"{resolved.SiteUrl}/_api/web/lists?$select=Title,BaseType&$top=5000");
            var all = doc.RootElement.GetProperty("value").EnumerateArray().ToList();
            foreach (var j in _jobs)
            {
                var match = all.Where(e => string.Equals(e.GetProperty("Title").GetString(), j.SourceListTitle.Trim(),
                    StringComparison.OrdinalIgnoreCase)).ToList();
                if (match.Count > 0)
                    j.IsLibrary = match[0].GetProperty("BaseType").GetInt32() == 1;
            }
        }
        catch { /* leave the default; the chip just stays conservative */ }
        StateHasChanged();
    }

    // Root folder path of the target list the explorer had open, and the title it had then.
    private string? _targetPath;
    private bool TargetPathApplies => !string.IsNullOrWhiteSpace(_targetPath)
        && string.Equals(_targetTitle?.Trim(), Pending.TargetListTitle?.Trim(), StringComparison.OrdinalIgnoreCase);

    // Live check of the target list: new / exists / type-mismatch. Non-blocking.
    private async Task CheckTargetAsync()
    {
        if (_batch || string.IsNullOrWhiteSpace(_targetTitle) || string.IsNullOrWhiteSpace(_tgt))
        {
            _targetState = TargetState.Unknown; _targetStateMsg = ""; StateHasChanged(); return;
        }
        var conn = UxConnectionResolver.Find(Settings, _tgt);
        if (conn is null || !UxConnectionResolver.CanResolve(conn, SignIn)) { _targetState = TargetState.Unknown; StateHasChanged(); return; }
        try
        {
            var resolved = UxConnectionResolver.Resolve(conn, _tgt, SignIn);
            // Compare titles on our side rather than with $filter=Title eq: SharePoint reports built-in
            // titles in the user's language but filters on the site's own, so the filter can miss a list
            // the explorer just showed. The root folder path, when known, settles it outright.
            using var doc = await resolved.Rest.GetJsonAsync(
                $"{resolved.SiteUrl}/_api/web/lists?$select=Title,BaseType,ItemCount,RootFolder/ServerRelativeUrl&$expand=RootFolder&$top=5000");
            var wantTitle = _targetTitle.Trim();
            var wantPath = TargetPathApplies ? _targetPath!.TrimEnd('/') : null;
            var all = doc.RootElement.GetProperty("value").EnumerateArray().ToList();
            var arr = all.Where(e => wantPath != null && string.Equals(
                    e.GetProperty("RootFolder").GetProperty("ServerRelativeUrl").GetString()?.TrimEnd('/'), wantPath, StringComparison.OrdinalIgnoreCase)).ToList();
            if (arr.Count == 0)
                arr = all.Where(e => string.Equals(e.GetProperty("Title").GetString(), wantTitle, StringComparison.OrdinalIgnoreCase)).ToList();
            if (arr.Count == 0)
            {
                _targetState = TargetState.New;
                _targetStateMsg = "New (will be created)";
            }
            else
            {
                var tgtIsLibrary = arr[0].GetProperty("BaseType").GetInt32() == 1;
                var count = arr[0].GetProperty("ItemCount").GetInt32();
                var srcIsLibrary = _jobs.Count > 0 && _jobs[0].IsLibrary;
                if (srcIsLibrary != tgtIsLibrary)
                {
                    _targetState = TargetState.Mismatch;
                    _targetStateMsg = $"Exists, but it's a {(tgtIsLibrary ? "library" : "list")} and your source is a {(srcIsLibrary ? "library" : "list")}.";
                }
                else
                {
                    _targetState = TargetState.Exists;
                    _targetStateMsg = $"Exists · {(tgtIsLibrary ? "Library" : "List")} · {count:N0} items. Items are added or updated per the mode below.";
                }
            }
        }
        catch { _targetState = TargetState.Unknown; _targetStateMsg = ""; }
        StateHasChanged();
    }

    // Friendly site name for the task title: the /sites/<name> segment, else the host label.
    private static string SiteName(string url)
    {
        try
        {
            var u = new Uri(url.TrimEnd('/'));
            var seg = u.Segments.LastOrDefault()?.Trim('/');
            return string.IsNullOrEmpty(seg) ? u.Host.Split('.')[0] : seg;
        }
        catch { return url; }
    }

    // Live preview of where the list will live on the target as the user types.
    private string FullTargetUrl()
    {
        var path = (string.IsNullOrWhiteSpace(_targetUrl) ? DefaultUrl(_targetTitle) : _targetUrl).Trim().TrimStart('/');
        return $"{_tgt.TrimEnd('/')}/{path}";
    }

    // Queue the task(s) into the background runner and go watch them on Activity.
    // Running in the runner (not this page) means navigating away never cancels them,
    // and several can run at once with the rest queued.
    private void Start()
    {
        if (string.IsNullOrWhiteSpace(_src) || string.IsNullOrWhiteSpace(_tgt) || _jobs.Count == 0)
        {
            Toasts.ShowWarning("Nothing to copy. Go back to the explorer and pick a source.");
            return;
        }
        if (!Migrations.CanRun(_src, _tgt, out var why))
        {
            _statusIntent = MessageIntent.Warning;
            _status = why;
            return;
        }

        var contentOnly = _copyMode == "content";
        var structureOnly = _copyMode == "structure";   // recreate list + schema, copy no items
        var queued = 0;
        foreach (var job in _jobs)
        {
            var title = _batch
                ? (_sameSite ? $"{job.SourceListTitle} - Copy" : job.SourceListTitle)
                : (string.IsNullOrWhiteSpace(_targetTitle) ? job.SourceListTitle : _targetTitle);
            var url = _batch || string.IsNullOrWhiteSpace(_targetUrl) ? DefaultUrl(title) : _targetUrl.Trim();
            var name = _batch ? $"{_taskName}: {job.SourceListTitle}" : _taskName;

            var options = new CopyOptions
            {
                TargetListTitle = title,
                TargetListUrl = url,
                // Language-independent keys. The target path only applies while the wizard still points
                // at the list the explorer had open; a retyped title means "a different list".
                SourceListServerRelativeUrl = job.SourceListPath,
                TargetListServerRelativeUrl = !_batch && TargetPathApplies ? _targetPath : null,
                TargetSubfolderRelative = _targetSubfolder,
                PreserveAuthorsAndDates = _preserve,
                CopyAttachments = _attachments,
                CopyPermissions = _permissions,
                PermissionsOnly = PermsOnly,
                ResetTargetWhereSourceInherits = PermsOnly && _resetInherit,
                CopyContent = !structureOnly,
                // Transfer files concurrently within a library copy (Settings default; the
                // engine caps it and forces sequential when permissions are being copied).
                ParallelFileTransfers = Settings.DefaultParallelFileTransfers,
                MergeSchema = !contentOnly,
                CopyViews = !contentOnly,
                CopyListSettings = !contentOnly,
                MaxVersions = _maxVersions,
                // Copy only what is inside the open source folder. Null = the whole list.
                SourceFolderServerRelativeUrl = job.SourceFolder,
                SelectedPaths = job.SelectedPaths,
                ItemIds = job.SelectedItemIds,
                ExistingMode = _existingMode switch
                {
                    "CopyIfNewer" => ExistingItemMode.CopyIfNewer,
                    "Skip" => ExistingItemMode.Skip,
                    _ => ExistingItemMode.Overwrite,
                },
                DateField = _dateField == "Created" ? DateFilterField.Created : DateFilterField.Modified,
                // Interpret each picked day as LOCAL and convert to UTC so the boundary
                // isn't off by the timezone. The whole day is inclusive on both ends:
                // "from" starts at the day's local midnight, "to" runs to end of that day.
                ModifiedSinceUtc = _useDateFilter && _dateFrom.HasValue ? LocalDayStartUtc(_dateFrom.Value) : null,
                ModifiedBeforeUtc = _useDateFilter && _dateTo.HasValue
                    ? LocalDayStartUtc(_dateTo.Value).Add(TimeSpan.FromDays(1))
                    : null,
            };

            // Resume: skip the paths the interrupted run already finished, so only the
            // remainder is copied. Partly-written files aren't in the copied set, so they
            // fall through to a normal (overwrite) re-copy.
            if (Pending.ResumeFromRunId is { } resumeId)
            {
                var done = History.GetCopiedSourcePaths(resumeId);
                if (done.Count > 0) options.ResumeSkipPaths = done;
            }

            Runner.Enqueue(name, _src, _tgt, job.SourceListTitle, options, _engine, job.IsLibrary);
            queued++;
        }

        Toasts.ShowSuccess(PermsOnly
            ? (queued == 1 ? "Permissions run queued." : $"{queued} permissions runs queued.")
            : (queued == 1 ? "Copy queued." : $"{queued} copies queued."));
        Nav.NavigateTo("/activity");
    }
}
